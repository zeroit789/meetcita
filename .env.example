APP_NAME="Appointments"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Reverse proxy IPs/CIDRs, comma-separated (empty = trust none; "*" only if the
# app is reachable ONLY through the proxy). Example for Coolify: 10.0.1.0/24
# IPs o CIDR del proxy inverso, separados por comas (vacío = ninguno; "*" solo si
# la app SOLO es accesible a través del proxy). Ejemplo para Coolify: 10.0.1.0/24
TRUSTED_PROXIES=

# ES: Idioma interno de Laravel (mensajes del framework). NO decide el idioma de
#     la web de reservas: ese sale de la cookie del selector, si no del navegador
#     (Accept-Language) y si no de appointments.default_locale (config/appointments.php).
# EN: Laravel's internal locale (framework messages). It does NOT decide the
#     booking site language: that comes from the switcher cookie, then the browser
#     (Accept-Language), then appointments.default_locale (config/appointments.php).
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# APPOINTMENTS — Booking system settings / Ajustes del sistema de reservas
# ==============================================================================
# ES: Rellena con TUS datos. Nada de esto es obligatorio para arrancar (degrada
#     con gracia), pero lo necesitas para la experiencia completa.
# EN: Fill these with YOUR data. None of these are required for the system to
#     boot (it degrades gracefully), but you need them for the full experience.
# ------------------------------------------------------------------------------

# --- 1. Branding / Marca ---
APPOINTMENTS_BRAND="Acme Inc."
APPOINTMENTS_OWNER_NAME="Jane Doe"
APPOINTMENTS_OWNER_ROLE="Founder"
# ES: Recibe avisos + Reply-To. EN: Receives "new appointment" alerts + used as Reply-To.
APPOINTMENTS_OWNER_EMAIL="hello@example.com"
APPOINTMENTS_WEBSITE="https://example.com"
APPOINTMENTS_LINKEDIN=

# --- 2. Booking code prefix / Prefijo del código (2-4 letters) ---
APPOINTMENTS_REF_PREFIX=APT
# Unsigned .ics links already emailed keep working for bookings created before this date (YYYY-MM-DD) /
# Los enlaces .ics sin firma ya enviados valen para citas creadas antes de esta fecha
APPOINTMENTS_ICS_UNSIGNED_UNTIL=

# --- 3. Business time zone / Zona horaria (valid PHP tz, e.g. America/New_York) ---
APPOINTMENTS_TIMEZONE=Europe/Madrid

# --- 4. Schedule / Horario ---
APPOINTMENTS_DAYS_AHEAD=14
APPOINTMENTS_OPEN=09:30
APPOINTMENTS_CLOSE=18:00
APPOINTMENTS_MAX_ATTENDEES=10
# Active bookings one email may hold at once (0 = no cap) / Citas activas por correo (0 = sin tope)
APPOINTMENTS_MAX_ACTIVE_PER_EMAIL=2

# --- 4c. Privacy (GDPR) / Privacidad (RGPD) ---
# Data controller shown in the first-layer notice (defaults to the brand) / Responsable (por defecto, la marca)
APPOINTMENTS_PRIVACY_CONTROLLER=
# Link to YOUR full privacy policy / Enlace a TU política de privacidad
APPOINTMENTS_PRIVACY_URL=
# Recipients (providers); empty = generic text / Destinatarios; vacío = texto genérico
APPOINTMENTS_PRIVACY_RECIPIENTS=
# Months past bookings are kept before citas:purgar deletes them (0 = never) /
# Meses que se guardan las citas pasadas antes de borrarlas (0 = nunca)
APPOINTMENTS_RETENTION_MONTHS=12

# --- 5. Modalities / Modalidades (at least one true) ---
APPOINTMENTS_MODALITY_ONLINE=true
APPOINTMENTS_MODALITY_IN_PERSON=true

# --- 6. Admin panel password / Contraseña del panel (/panel) — SET A STRONG ONE ---
APPOINTMENTS_PANEL_PASSWORD=

# --- 7. Default theme / Tema por defecto: dark | light | auto ---
# ES: El visitante puede cambiarlo igual (sol/luna); esto es solo el de partida.
# EN: Visitors can toggle anyway (sun/moon); this is just the default.
APPOINTMENTS_THEME=light

# --- 7b. Accent colour / Color de acento (#rrggbb) ---
# ES: Color del negocio (botones, día elegido). Va con texto blanco encima: elige
#     un tono oscuro (mínimo 4,5:1 con blanco). Si no es un hex válido, se usa el
#     de por defecto. ACCENT_GLOW es opcional (tono claro para el tema oscuro).
# EN: Business colour (buttons, chosen day). White text goes on top: pick a
#     dark shade (at least 4.5:1 against white). Invalid hex = default is used.
#     ACCENT_GLOW is optional (light shade for the dark theme).
# ES: Entre comillas: sin ellas, el # se lee como comentario.
# EN: Keep the quotes: without them, the # is read as a comment.
APPOINTMENTS_ACCENT="#1d4ed8"
APPOINTMENTS_ACCENT_GLOW=

# ------------------------------------------------------------------------------
# Google Calendar + Meet (OPTIONAL / OPCIONAL)
# ES: Sin esto, las citas online funcionan pero SIN enlace de Meet automático y
#     sin sincronizar el calendario. Mira docs/GOOGLE.md para sacar cada valor.
# EN: Without these, online bookings still work but get NO auto Meet link and
#     the calendar won't sync. See docs/GOOGLE.md to get each value.
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_REDIRECT_URI=http://localhost

# ------------------------------------------------------------------------------
# Telegram bot (OPTIONAL / OPCIONAL)
# ES: Recibe avisos al instante y confirma/rechaza citas desde el móvil. Sin
#     esto, gestionas todo desde el /panel. Mira docs/TELEGRAM.md.
# EN: Get instant alerts and confirm/reject bookings from your phone. Without
#     these, you manage everything from the /panel instead. See docs/TELEGRAM.md.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Own captcha (ALTCHA, no third parties) / Captcha propio (ALTCHA, sin terceros)
# ------------------------------------------------------------------------------
# false = no captcha (e.g. intranet) / false = sin captcha (p. ej. intranet)
ALTCHA_ENABLED=true
# Optional own HMAC key (defaults to APP_KEY) / Clave HMAC propia opcional (por defecto, APP_KEY)
ALTCHA_HMAC_KEY=

# ------------------------------------------------------------------------------
# Public demo / Demo pública — NEVER on a real install / NUNCA en una instalación real
# ------------------------------------------------------------------------------
# true = mail to the log, no Telegram/Google, demo notice, known panel password, hourly reset
# true = correo al log, sin Telegram/Google, aviso de demo, contraseña conocida, reinicio cada hora
MEETCITA_DEMO=false
MEETCITA_DEMO_PANEL_PASSWORD=demo

# ── Hours, self-service, reminders and WhatsApp / Horario por día, autogestión, recordatorios y WhatsApp ──
# ES: Horario por día (opcional). Si tiene algo, manda él y APPOINTMENTS_OPEN,
#     APPOINTMENTS_CLOSE y los días laborables se ignoran. Grupos separados por
#     ";": día o rango ISO (1 = lunes … 7 = domingo) y sus tramos.
# EN: Per-day hours (optional). If set, it wins and APPOINTMENTS_OPEN,
#     APPOINTMENTS_CLOSE and the working days are ignored. Groups split by ";":
#     ISO day or range (1 = Monday … 7 = Sunday) and its ranges.
#APPOINTMENTS_HOURS="1-4 09:00-14:00 16:00-19:00; 5 09:00-14:00"
APPOINTMENTS_HOURS=

# ES: Teléfono de contacto que ve el cliente cuando ya no puede cambiar su cita.
# EN: Contact phone the client sees when they can no longer change their booking.
APPOINTMENTS_PHONE=

# ES: Autogestión: enlace en los correos para cancelar o cambiar la cita, hasta
#     N horas antes (0 = hasta que empiece).
# EN: Self-service: link in the emails to cancel or change the booking, up to
#     N hours before (0 = until it starts).
APPOINTMENTS_SELF_SERVICE=true
APPOINTMENTS_SELF_SERVICE_HOURS_BEFORE=24

# ES: Recordatorio por correo la víspera (necesita el scheduler) y hora local
#     desde la que se envía.
# EN: Day-before email reminder (needs the scheduler) and local time from
#     which it is sent.
APPOINTMENTS_REMINDERS=true
APPOINTMENTS_REMINDERS_FROM=09:00

# ES: Botón de WhatsApp en el panel y prefijo de país para números sin + ni 00.
# EN: WhatsApp button in the panel and country prefix for numbers without + or 00.
APPOINTMENTS_WHATSAPP_LINK=false
APPOINTMENTS_WHATSAPP_COUNTRY_CODE=34
